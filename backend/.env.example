# Copy to .env and fill in. Docker Compose reads this file.

# Required — long random string, e.g.  openssl rand -base64 48
JWT_SECRET=
# Required — invite key people enter to create an account. Share it only with your group.
SETUP_KEY=

# Optional — the first account created becomes admin; you can also pin one by name.
ADMIN_USERNAME=
# Maximum number of accounts (0 = unlimited)
MAX_USERS=10

# Public URL of your instance, used in emails
APP_URL=http://localhost:3001
PORT=3001
UPLOAD_DIR=./uploads
# Only needed if the frontend is served from a different origin
CORS_ORIGIN=

# Max upload size in bytes (0 = no limit)
MAX_FILE_SIZE=0

# Optional — SMTP for password reset and upload notification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Private Server <noreply@example.com>
